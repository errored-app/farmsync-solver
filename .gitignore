# Credentials — real api_key / farm_token live here. Never commit.
input/config.json

# start.bat sentinel
.deps_installed

# PyInstaller build output. Regenerated by build.bat; the .exe is distributed
# through GitHub Releases, never through git.
build/
dist/

# Tool-written account state. Regenerated on demand — losing it costs one pass
# of redundant dispatch. The file specifically, not data/, which is committed
# on purpose: it holds the probe evidence an earlier calibration run lost.
data/state.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Not published. All five stay on disk; they are simply not GitHub's business.
# CLAUDE.md and docs/ are internal working notes, data/ names real devices and
# accounts, scripts/ drives the live APIs and spends real credit, and
# .superpowers/ holds SDD briefs, implementer reports, and review diffs for
# this very packaging plan. .superpowers/ was previously kept out only by a
# nested, harness-generated .superpowers/sdd/.gitignore this repository does
# not own; publish.bat runs `git add -A` on an orphan branch and force-pushes
# it unattended, so this repo's own .gitignore must exclude it directly —
# a missing nested file (fresh clone, harness cleanup, manual delete) must
# not be able to publish it.
CLAUDE.md
data/
docs/
scripts/
.superpowers/
